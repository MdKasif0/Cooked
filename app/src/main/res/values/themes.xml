<resources>
    <style name="Theme.Cooked" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Cooked.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F9F9F7</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Cooked</item>
    </style>
</resources>
